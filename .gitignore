# Build output
dist/

# The Appwrite Function's embedded catalogue. It is regenerated from
# data/catalog.json by scripts/build-appwrite-function.mjs, so it is never
# committed - it would be an 800 KB duplicate of a file that is already in
# the repo.
appwrite/functions/premium-api/src/catalog.js

# Wrangler's local state and build cache. It can contain account details.
.wrangler/

# Node
node_modules/

# macOS
.DS_Store

# Editors
.vscode/
.idea/
*.swp

# Local secrets - never commit real affiliate tracking URLs if you prefer to
# manage them out-of-band. config/affiliates.json IS committed, but keep any
# credential-bearing variant out of the repo.
*.env
.env*
